# Copy to .env and fill in.  .env is gitignored — never commit real values.

# Camera RTSP source
CAM_USER=
CAM_PASS=
CAM_IP=
CAM_PORT=554
CAM_STREAM=

# YouTube Live stream key (Studio > Go Live > Stream key)
YOUTUBE_KEY=

# The page Chromium loads (the camera view / dashboard)
URL=

# ── watchdog tunables (optional; defaults in start.sh) ───────────────
# CHECK_SECS=60
# BLACK_HITS=3
# BLACK_LEVEL=16
# CAM_CROP=600:400:428:285
# FREEZE_HITS=3
