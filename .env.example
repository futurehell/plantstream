# Copy to .env and fill in.  .env is gitignored — never commit real values.

# YouTube Live stream key (Studio > Go Live > Stream key)
YOUTUBE_KEY=

# The page Chromium loads (the camera view / dashboard)
URL=

# ── feed watchdog tunables (optional; defaults in start.sh) ──────────────────
# CHECK_SECS=60              # how often to sample the display
# BLACK_HITS=3               # consecutive dark samples before reloading
# BLACK_LEVEL=16             # avg luma 0-255; below this = "black"
# CAM_CROP=600:400:428:285   # WxH:X:Y sample box inside the camera feed
# FREEZE_HITS=3              # consecutive byte-identical frames before reloading
# MIN_FRAME_BYTES=800000     # frames PNG-compressing smaller = "blank/loading"
# BLANK_HITS=3               # consecutive tiny frames before reloading

# ── uplink watchdog tunables (optional; defaults in start.sh) ────────────────
# UPLINK_CHECK_SECS=15       # how often to verify ffmpeg is still pushing
# UPLINK_STALL_SECS=60       # no output progress for this long = restart container
# PROGRESS_FILE=/tmp/ffprogress.txt
